{
  "name": "kokoro-tts",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  // Persist downloaded model weights and voices across rebuilds
  "mounts": ["source=kokoro-cache,target=/cache,type=volume"],
  // Make `uv sync` / `uv run` in the workspace reuse the venv baked into the image
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/app/.venv"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/app/.venv/bin/python"
      }
    }
  }
}
